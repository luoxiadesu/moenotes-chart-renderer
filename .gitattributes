* text=auto
*.rs text eol=lf
*.c text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
# Synthetic snapshot hashes are byte-based on every platform.
tests/fixtures/masterdata/*.json text eol=lf
*.png binary
*.ttf binary
*.otf binary
vendor/** -text whitespace=-blank-at-eol,-blank-at-eof
assets/licenses/** -text whitespace=-blank-at-eol,-blank-at-eof
assets/fonts/*LICENSE* -text whitespace=-blank-at-eol,-blank-at-eof
assets/fonts/OFL-1.1.txt -text whitespace=-blank-at-eol,-blank-at-eof
